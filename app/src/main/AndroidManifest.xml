<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_workout"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.KarooIntervals">

        <!-- Workout picker: launcher, Karoo extension list (CONFIGURE_EXTENSION), and the
             gear tap zone on the ride screen. -->
        <activity
            android:name=".ui.WorkoutsActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="io.hammerhead.karooext.CONFIGURE_EXTENSION" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".screen.TapReceiver"
            android:exported="false" />

        <service
            android:name=".extension.IntervalsExtension"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="io.hammerhead.karooext.KAROO_EXTENSION" />
            </intent-filter>
            <meta-data
                android:name="io.hammerhead.karooext.EXTENSION_INFO"
                android:resource="@xml/extension_info" />
        </service>
    </application>

</manifest>
